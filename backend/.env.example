# Spotify OAuth (get from https://developer.spotify.com/dashboard)
# Create an app with Redirect URI: http://localhost:8000/api/auth/callback
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated origins for frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# JWT Session (30 days default)
JWT_EXPIRES_MIN=43200

# Loop engine
LOOP_POLL_MS=200
USER_ACTION_GRACE_MS=500